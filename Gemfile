# ============================================================================
# Gemfile — このアプリが使う外部ライブラリ（gem）の一覧
#
# Node.jsの package.json、Pythonの requirements.txt に相当する。
# `bundle install` でここに書かれたgemが一括で入る。
#
# 【追加したgemには「どの段階で使うか」を書いてある】
#   まだ使っていないgemが混ざっているのは意図的。
#   gemを足すたびにイメージを作り直す必要があり、
#   その待ち時間を毎回挟むより、先にまとめて入れた方が学習が進む。
# ============================================================================

source "https://rubygems.org"

# ----------------------------------------------------------------------------
# Rails本体と土台
# ----------------------------------------------------------------------------

# 【"~> 8.1.3" の意味】「8.1.3以上、8.2未満」。
#   ~> は「悲観的バージョン指定」と呼ばれ、
#   バグ修正は取り込むが破壊的変更は勝手に入れない、という指定。
gem "rails", "~> 8.1.3"

# CSSや画像などの静的ファイルを配信する仕組み（Rails 8の標準）。
gem "propshaft"

# PostgreSQLに接続するためのドライバ。
# 【なぜ必要か】Railsは特定のDBに依存しない作りになっていて、
#   実際に喋る部分はこういうgemが担当する。
#   MySQLなら mysql2 に差し替えるだけでコードは変えずに済む。
gem "pg", "~> 1.1"

# Webサーバー本体。
# 【役割】ブラウザからのHTTPリクエストを最初に受け取り、Railsに渡す。
#   Rails自体はサーバーではなく「リクエストを処理する仕組み」なので、
#   実際に通信を待ち受ける係が別に要る。それがPuma。
gem "puma", ">= 5.0"

# 起動高速化。読み込んだファイルの解析結果をキャッシュする。
gem "bootsnap", require: false

# Windowsなどタイムゾーン情報を持たないOS向けの補完データ。
gem "tzinfo-data", platforms: %i[ windows jruby ]

# ----------------------------------------------------------------------------
# Redis（段階1から必要）
# ----------------------------------------------------------------------------
# 【なぜ今すぐ必要か】
#   config/cable.yml の development を adapter: redis にしたため。
#   このgemが無いとRailsは起動時点で「redisアダプタが見つからない」と
#   言って落ちる。設定とgemはセットで揃える必要がある。
#
# 【このアプリでのRedisの2つの役割】
#   ① Sidekiqのジョブキュー（段階5）
#   ② Action Cableのpub/sub — 別プロセス間の通知の受け渡し（段階5）
gem "redis", ">= 4.0.1"

# ----------------------------------------------------------------------------
# 認証（段階2で使用）
# ----------------------------------------------------------------------------
# パスワードのハッシュ化を行うライブラリ。
#
# 【なぜ「暗号化」ではなく「ハッシュ化」なのか】← 認証の最重要ポイント
#   暗号化は鍵があれば元に戻せる。ハッシュ化は原理的に戻せない。
#   パスワードは「元に戻す必要が無い」ので、戻せない方式を使う。
#   ログイン時は「入力値を同じ手順でハッシュ化して、保存済みの値と一致するか」
#   を見るだけで済み、平文のパスワードはどこにも保存しなくてよい。
#   → DBが丸ごと漏れても、パスワードそのものは漏れない。
#
# 【なぜbcryptか】わざと計算が遅くなるよう設計されている。
#   総当たり攻撃は「1秒間に何回試せるか」が勝負なので、
#   1回の計算を意図的に遅くすると攻撃コストが跳ね上がる。
#   （SHA-256のような高速なハッシュはパスワード用途には不適切）
#   Railsの has_secure_password はこのgemを使う。
gem "bcrypt", "~> 3.1.7"

# ----------------------------------------------------------------------------
# 非同期ジョブ（段階5で使用）
# ----------------------------------------------------------------------------
# 【役割】AI解説の生成には10秒かかる。それをHTTPリクエストの中で待つと
#   ブラウザが固まりサーバーのプロセスも占有される。
#   Sidekiqは「あとでやっといて」という依頼をRedisに積み、
#   別プロセスが順に処理する仕組み。
#
# 【なぜSolid Queueではなくこれか】実務での遭遇率が圧倒的に高く、
#   Web UI でジョブの実行中・成功・失敗・リトライが目で見える。
#   「非同期処理で何が起きているか」を学ぶのに向いている。
gem "sidekiq", "~> 8.0"

# ----------------------------------------------------------------------------
# Claude API（段階4で使用）
# ----------------------------------------------------------------------------
# Anthropic公式のRuby SDK。
# 【なぜ自分でHTTPを書かないか】リトライ・タイムアウト・エラーの型分け・
#   structured output（JSON形式の強制）などが最初から入っている。
#   自作すると必ずどこかで抜けが出る部分なので、既製品を使う。
gem "anthropic"

# ----------------------------------------------------------------------------
# 開発・テスト両方で使うgem
# ----------------------------------------------------------------------------
group :development, :test do
  # デバッガ。コードの途中で止めて変数の中身を覗ける。
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # テストフレームワーク（段階2以降で使用）。
  # 【なぜMinitestではなくRSpecか】rails new で --skip-test を指定して
  #   Minitestを生成しなかったのは、こちらを使うと決めたため。
  #   RSpecは実務での採用率が高く、`it "他人の単語は404" do` のように
  #   「何を保証したいか」が日本語同然に読める書き方ができる。
  gem "rspec-rails", "~> 7.1"

  # テスト用データの生成器。
  # 【役割】テストのたびに User.create!(email: ..., password: ...) と
  #   全項目を書くのは冗長で、項目が増えるたび全テストの修正が必要になる。
  #   「標準的なUserの作り方」を1箇所に定義しておく仕組み。
  gem "factory_bot_rails"

  # 外部HTTP通信をテスト中に遮断・偽装するライブラリ。
  # 【なぜ必須か】テストのたびに本物のClaude APIを呼ぶと、
  #   ①毎回課金される ②1回10秒かかる ③返答が毎回違って結果が安定しない。
  #   さらに「APIが500を返したら3回リトライするか」のような異常系は、
  #   本物のAPIでは再現できない（わざと壊してくれないため）。
  #   WebMockなら「今回は500を返す」を自由に作れる。
  gem "webmock"

  # セキュリティ検査（脆弱性の静的解析）。
  gem "brakeman", require: false

  # 依存gemに既知の脆弱性が無いか検査する。
  gem "bundler-audit", require: false

  # コードスタイルの自動チェック。
  # 【なぜ入れるか】インデントや書き方の揺れを機械が指摘してくれる。
  #   「Rubyらしい書き方」を覚える近道になる。
  gem "rubocop-rails-omakase", require: false
end

# ----------------------------------------------------------------------------
# 開発時のみ
# ----------------------------------------------------------------------------
group :development do
  # エラー画面上でその場でコードを実行できるコンソール。
  gem "web-console"
end

gem "vite_rails", "~> 3.11"
