# ============================================================================
# 開発用 Dockerfile
#
# 【Dockerfileとは】
#   「まっさらなLinuxに、何をどの順でインストールすれば、このアプリが動く環境に
#    なるか」を書いた手順書。この手順書から作られるのが「イメージ」で、
#    イメージを起動したものが「コンテナ」。
#
#   料理でたとえると：Dockerfile = レシピ、イメージ = 冷凍された完成品、
#   コンテナ = それを解凍して皿に盛ったもの。
#
# 【なぜ .dev と分けているか】
#   開発用と本番用では欲しいものが違う。開発用は「コードを書き換えたら即反映」
#   「デバッグツール入り」が欲しい。本番用は「軽い」「セキュア」「起動が速い」が
#   欲しい。1つのDockerfileで両方やろうとすると条件分岐だらけになるので分ける。
#   本番用は段階8（デプロイ）で別途 Dockerfile として作る。
# ============================================================================

# ----------------------------------------------------------------------------
# ベースイメージの指定
# ----------------------------------------------------------------------------
# FROM = 「どのイメージを土台にするか」。ゼロからLinuxを作るのではなく、
# Ruby入りのLinuxが公式に配布されているのでそれを使う。
#
# 【なぜ 3.3-slim か】
#   ・3.3 … Rails 8 が安定して動くRubyバージョン。「latest」にすると、ある日
#           勝手にRubyが上がって動かなくなる。バージョンは必ず固定する。
#   ・slim … 「最小構成」版。無印(debian full)は約1GB、slimは約200MB。
#           開発に必要なものは後から自分で入れるので、小さい方から始める。
#           （さらに小さい alpine もあるが、Cライブラリが違うため
#             一部のgemのビルドで詰まりやすい。初心者には slim が安全）
FROM ruby:3.3-slim

# ----------------------------------------------------------------------------
# OSパッケージのインストール
# ----------------------------------------------------------------------------
# 【なぜこれらが必要か】Rubyだけでは足りないものがある。
#   build-essential  … gcc等のコンパイラ。一部のgem（pg, bcrypt等）はC言語で
#                       書かれた部分があり、インストール時にコンパイルされる。
#   libpq-dev        … PostgreSQLに接続するためのC言語ライブラリ。
#                       pg gem がこれを使ってビルドされる。無いと bundle install が落ちる。
#   git              … 一部のgemがGitHubから直接取得される場合に必要。
#   curl             … Node.jsのインストールスクリプト取得に使う。
#   nodejs / npm     … Vue(フロントエンド)のビルドに必要。RubyだけではJSは扱えない。
#
# 【なぜ && で1行に繋いでいるか】
#   Dockerは命令1行ごとに「レイヤー」という中間状態を保存する。
#   RUN を3回に分けると3レイヤーできてイメージが太る。1つのRUNにまとめると1レイヤー。
#
# 【なぜ最後に rm -rf /var/lib/apt/lists/* しているか】
#   apt-get update でダウンロードしたパッケージ一覧のキャッシュ（数十MB）が残る。
#   インストール後は不要なので同じRUN内で消す。別のRUNで消してもレイヤーには
#   残ってしまうので、必ず同じ行で消すのがポイント。
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      libpq-dev \
      git \
      curl \
      ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install --no-install-recommends -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------------------
# 作業ディレクトリの指定
# ----------------------------------------------------------------------------
# コンテナの中でのカレントディレクトリ。これ以降の COPY / RUN / CMD は
# すべてこの場所を基準に実行される。無ければ自動で作られる。
#
# 【なぜ /app か】決まりはない。慣習。/usr/src/app なども見かける。
# 大事なのは「一箇所に決めて、compose側の設定と一致させること」。
WORKDIR /app

# ----------------------------------------------------------------------------
# 依存関係のインストール
# ----------------------------------------------------------------------------
# 【なぜ Gemfile だけ先に COPY するのか】← ここがDockerで一番重要な考え方
#
#   Dockerは各命令の結果をキャッシュする。そして「前の行が変わらなければ、
#   その行のキャッシュを再利用する」。
#
#   もしアプリのコード全部を先にCOPYしてから bundle install すると、
#   コードを1文字直すたびにCOPYのキャッシュが壊れ、その後の
#   bundle install も毎回やり直しになる（毎回3〜5分待つ）。
#
#   Gemfile だけ先にコピーしておけば、「Gemfileが変わっていない限り」
#   bundle install はキャッシュが効いて一瞬で終わる。
#   gemを追加したときだけ再実行される。これが正しい順序。
#
#   ＝ 「変わりにくいものを先に、変わりやすいものを後に」がDockerの鉄則。
COPY Gemfile Gemfile.lock ./
RUN bundle install

# ----------------------------------------------------------------------------
# アプリのコードをコピー
# ----------------------------------------------------------------------------
# 【補足】開発環境では docker-compose.yml の volumes 設定でホスト側の
#   ディレクトリを丸ごと上書きマウントするので、このCOPYの内容は実質使われない。
#   それでも書いておく理由は、volumesを使わずにこのイメージ単体で
#   動かしたいとき（CI等）に必要だから。
COPY . .

# ----------------------------------------------------------------------------
# 起動時に実行されるコマンド
# ----------------------------------------------------------------------------
# 【なぜ 0.0.0.0 なのか】← ハマりどころ
#   Railsのデフォルトは 127.0.0.1（localhost）にだけ応答する設定。
#   しかし「コンテナの中のlocalhost」は「コンテナの中」しか指さないので、
#   ホストPC（あなたのWindows）からアクセスしても届かない。
#   0.0.0.0 は「どのネットワークインターフェースからの接続も受ける」という意味。
#   これを指定して初めて、コンテナの外から繋がるようになる。
#
# 【なぜ tmp/pids/server.pid を消すのか】
#   Railsは起動時に「自分のプロセスID」をこのファイルに書く。
#   コンテナを強制終了するとファイルが残り、次回起動時に
#   「すでにサーバーが動いています」と誤判定して起動できなくなる。
#   起動のたびに消しておけば、この事故を防げる。
CMD ["sh", "-c", "rm -f tmp/pids/server.pid && bundle exec rails server -b 0.0.0.0 -p 3000"]
