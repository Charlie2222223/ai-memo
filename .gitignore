# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


# ============================================================================
# 秘密情報（絶対にコミットしない）
# ============================================================================
# 【なぜ必要か】.env には Anthropic のAPIキーが入る。
#   これをコミットしてGitHubに上げると、公開リポジトリを24時間
#   スキャンしているボットに数分で拾われ、他人があなたの課金で
#   APIを叩けるようになる。実際に多発している事故。
#
# 【重要】一度コミットしてしまうと、後からファイルを消しても
#   Gitの履歴には残り続ける。「消したから大丈夫」は通用しない。
#   その場合はキーを無効化して再発行するしかない。
#   だから「最初からコミットしない」ことが唯一の対策になる。
# Rails の既定ルール /.env* が .env / .env.local などを既に除外している。
# ここではその「例外」だけを足す。

# .env.example だけは例外。値がダミーなので安全で、
# 「どんな変数が必要か」を他の人に伝えるために必要。
# ! は「除外の除外」＝これは無視しない、という意味。
!.env.example

# Vite Ruby
/public/vite*
node_modules
# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local

